  "scanf": {
    "scene": "p2-scanf",
    "steps": [
      {
        "line": 5,
        "ms": 900,
        "note": "int guess makes an empty box. It holds junk (shown as ?) until something is put in.",
        "do": [
          {
            "i": 0,
            "a": "decl"
          }
        ]
      },
      {
        "line": 6,
        "ms": 900,
        "note": "char again is a second box, for one character.",
        "do": [
          {
            "i": 1,
            "a": "decl"
          }
        ]
      },
      {
        "line": 8,
        "ms": 900,
        "note": "printf shows the question. (Sample run: the player types 42, then y.)",
        "do": [],
        "out": "Guess a number: ",
        "outAt": 0.3
      },
      {
        "line": 9,
        "ms": 1300,
        "note": "scanf waits for the player. They type 4, 2 and Enter, and everything sits in the keyboard buffer, including the Enter mark.",
        "do": [
          {
            "a": "cap",
            "t": "waiting for the player...",
            "len": 0.25
          },
          {
            "a": "type",
            "t": "42\n",
            "at": 0.25,
            "len": 0.75
          }
        ]
      },
      {
        "line": 9,
        "ms": 1200,
        "note": "scanf(\"%d\", &guess): the &guess part is the address of the guess box, so scanf knows where to put the number.",
        "do": [
          {
            "i": 0,
            "call": "scanf(\"%d\", &guess)",
            "a": "aim"
          }
        ]
      },
      {
        "line": 9,
        "ms": 1700,
        "note": "%d reads the digits 4 and 2 and stops at Enter. The number 42 travels to that address and lands in guess.",
        "do": [
          {
            "n": 2,
            "i": 0,
            "val": "42",
            "a": "take"
          }
        ]
      },
      {
        "line": 10,
        "ms": 1000,
        "note": "guess now holds 42, so printf shows it. The Enter mark is still waiting in the buffer.",
        "do": [],
        "out": "You guessed 42\n",
        "outAt": 0.4
      },
      {
        "line": 12,
        "ms": 900,
        "note": "Next question for the player.",
        "do": [],
        "out": "Play again? (y/n) ",
        "outAt": 0.3
      },
      {
        "line": 13,
        "ms": 1300,
        "note": "scanf waits again. The player types y and Enter. Now the buffer holds the old Enter mark, then y, then another Enter.",
        "do": [
          {
            "a": "cap",
            "t": "waiting for the player...",
            "len": 0.25
          },
          {
            "a": "type",
            "t": "y\n",
            "at": 0.25,
            "len": 0.75
          }
        ]
      },
      {
        "line": 13,
        "ms": 1300,
        "note": "scanf(\" %c\", &again): the space before %c means skip any leftover whitespace first. &again is the address of the again box.",
        "do": [
          {
            "i": 1,
            "call": "scanf(\" %c\", &again)",
            "a": "aim"
          }
        ]
      },
      {
        "line": 13,
        "ms": 1200,
        "note": "The space skips the old Enter mark. Without it, %c would grab that Enter as the answer.",
        "do": [
          {
            "n": 1,
            "a": "skip"
          }
        ]
      },
      {
        "line": 13,
        "ms": 1500,
        "note": "Now %c takes one character, y, and sends it to the address of again.",
        "do": [
          {
            "n": 1,
            "i": 1,
            "val": "y",
            "a": "take"
          }
        ]
      },
      {
        "line": 14,
        "ms": 800,
        "note": "return 0 means the program finished fine.",
        "do": []
      }
    ]
  },
  "math": {
    "scene": "p2-calc",
    "steps": [
      {
        "line": 4,
        "ms": 900,
        "note": "a is 7 and b is 2. Both are ints.",
        "do": [
          {
            "t": "a = 7    b = 2",
            "a": "vars"
          }
        ]
      },
      {
        "line": 5,
        "ms": 1000,
        "note": "a / b: an int divided by an int.",
        "do": [
          {
            "x": {
              "v": "7",
              "t": "int"
            },
            "op": "/",
            "y": {
              "v": "2",
              "t": "int"
            },
            "label": "a / b",
            "a": "expr"
          }
        ]
      },
      {
        "line": 5,
        "ms": 1700,
        "note": "The true answer is 3.5, but int with int stays int. The .5 is chopped off and the answer is 3.",
        "do": [
          {
            "v": "3",
            "t": "int",
            "frac": ".5",
            "len": 0.7,
            "a": "calc"
          },
          {
            "t": "int / int = int",
            "at": 0.6,
            "len": 0.4,
            "a": "rule"
          }
        ],
        "out": "3\n",
        "outAt": 0.7
      },
      {
        "line": 6,
        "ms": 1000,
        "note": "a % b is the remainder after dividing.",
        "do": [
          {
            "x": {
              "v": "7",
              "t": "int"
            },
            "op": "%",
            "y": {
              "v": "2",
              "t": "int"
            },
            "label": "a % b",
            "a": "expr"
          }
        ]
      },
      {
        "line": 6,
        "ms": 1400,
        "note": "2 goes into 7 three times (that is 6), and 1 is left over. So the answer is 1.",
        "do": [
          {
            "v": "1",
            "t": "int",
            "a": "calc"
          },
          {
            "t": "% gives the leftover",
            "at": 0.5,
            "len": 0.5,
            "good": true,
            "a": "rule"
          }
        ],
        "out": "1\n",
        "outAt": 0.6
      },
      {
        "line": 7,
        "ms": 1000,
        "note": "a / 2.0f: this time one side is a float.",
        "do": [
          {
            "x": {
              "v": "7",
              "t": "int"
            },
            "op": "/",
            "y": {
              "v": "2.0",
              "t": "float"
            },
            "label": "a / 2.0f",
            "a": "expr"
          }
        ]
      },
      {
        "line": 7,
        "ms": 1900,
        "note": "C turns the 7 into 7.0 first, and then divides. Float with float gives 3.5. Nothing is chopped.",
        "do": [
          {
            "side": "a",
            "v": "7.0",
            "t": "float",
            "tag": "promoted",
            "len": 0.45,
            "a": "cast"
          },
          {
            "v": "3.5",
            "t": "float",
            "at": 0.5,
            "len": 0.4,
            "a": "calc"
          },
          {
            "t": "one float in, float out",
            "at": 0.7,
            "len": 0.3,
            "good": true,
            "a": "rule"
          }
        ],
        "out": "3.500000\n",
        "outAt": 0.85
      },
      {
        "line": 8,
        "ms": 1000,
        "note": "(float)a / b: the cast sits on a, so it happens before the division.",
        "do": [
          {
            "x": {
              "v": "7",
              "t": "int"
            },
            "op": "/",
            "y": {
              "v": "2",
              "t": "int"
            },
            "label": "(float)a / b",
            "a": "expr"
          }
        ]
      },
      {
        "line": 8,
        "ms": 2100,
        "note": "The cast makes a 7.0. Then b is promoted to 2.0 to match. The division is float, and the answer is 3.5.",
        "do": [
          {
            "side": "a",
            "v": "7.0",
            "t": "float",
            "tag": "(float)",
            "len": 0.3,
            "a": "cast"
          },
          {
            "side": "b",
            "v": "2.0",
            "t": "float",
            "tag": "promoted",
            "at": 0.3,
            "len": 0.3,
            "a": "cast"
          },
          {
            "v": "3.5",
            "t": "float",
            "at": 0.65,
            "len": 0.3,
            "a": "calc"
          },
          {
            "t": "cast first, then divide",
            "at": 0.8,
            "len": 0.2,
            "good": true,
            "a": "rule"
          }
        ],
        "out": "3.500000\n",
        "outAt": 0.9
      },
      {
        "line": 9,
        "ms": 1000,
        "note": "(float)(a / b): now the brackets put the division inside the cast.",
        "do": [
          {
            "x": {
              "v": "7",
              "t": "int"
            },
            "op": "/",
            "y": {
              "v": "2",
              "t": "int"
            },
            "label": "(float)(a / b)",
            "a": "expr"
          }
        ]
      },
      {
        "line": 9,
        "ms": 1500,
        "note": "The division happens first as ints, so 7 / 2 is already 3. The .5 is gone.",
        "do": [
          {
            "v": "3",
            "t": "int",
            "frac": ".5",
            "len": 0.8,
            "a": "calc"
          },
          {
            "t": "int / int = int",
            "at": 0.6,
            "len": 0.4,
            "a": "rule"
          }
        ]
      },
      {
        "line": 9,
        "ms": 1600,
        "note": "Then the cast turns that 3 into 3.0. Too late: the lost .5 does not come back.",
        "do": [
          {
            "side": "r",
            "v": "3.0",
            "t": "float",
            "tag": "(float)",
            "len": 0.55,
            "a": "cast"
          },
          {
            "t": "cast too late",
            "at": 0.6,
            "len": 0.4,
            "a": "rule"
          }
        ],
        "out": "3.000000\n",
        "outAt": 0.8
      },
      {
        "line": 10,
        "ms": 800,
        "note": "return 0 means the program finished fine.",
        "do": []
      }
    ]
  },
  "operators": {
    "scene": "p2-calc",
    "steps": [
      {
        "line": 4,
        "ms": 1100,
        "note": "Three int boxes: score 10, lives 3, hits 4. combo has no value yet.",
        "do": [
          {
            "a": "vars",
            "t": "score = 10   lives = 3   hits = 4"
          }
        ]
      },
      {
        "line": 9,
        "ms": 1000,
        "note": "score += 5 is score = score + 5.",
        "do": [
          {
            "a": "expr",
            "x": {
              "v": "10",
              "t": "int"
            },
            "op": "+",
            "y": {
              "v": "5",
              "t": "int"
            },
            "label": "score += 5"
          }
        ]
      },
      {
        "line": 9,
        "ms": 1200,
        "note": "The answer, 15, goes back into score.",
        "do": [
          {
            "a": "calc",
            "v": "15",
            "t": "int"
          },
          {
            "a": "vars",
            "t": "score = 15   lives = 3   hits = 4",
            "at": 0.5
          },
          {
            "a": "rule",
            "t": "x += y  is  x = x + y",
            "good": true,
            "at": 0.5
          }
        ]
      },
      {
        "line": 10,
        "ms": 1300,
        "note": "score *= 2 multiplies in place: 15 becomes 30.",
        "do": [
          {
            "a": "expr",
            "x": {
              "v": "15",
              "t": "int"
            },
            "op": "*",
            "y": {
              "v": "2",
              "t": "int"
            },
            "label": "score *= 2",
            "len": 0.3
          },
          {
            "a": "calc",
            "v": "30",
            "t": "int",
            "at": 0.35,
            "len": 0.4
          },
          {
            "a": "vars",
            "t": "score = 30   lives = 3   hits = 4",
            "at": 0.75
          }
        ]
      },
      {
        "line": 11,
        "ms": 1200,
        "note": "lives-- takes 1 off: 3 becomes 2.",
        "do": [
          {
            "a": "expr",
            "x": {
              "v": "3",
              "t": "int"
            },
            "op": "-",
            "y": {
              "v": "1",
              "t": "int"
            },
            "label": "lives--",
            "len": 0.3
          },
          {
            "a": "calc",
            "v": "2",
            "t": "int",
            "at": 0.35,
            "len": 0.4
          },
          {
            "a": "vars",
            "t": "score = 30   lives = 2   hits = 4",
            "at": 0.75
          }
        ]
      },
      {
        "line": 12,
        "ms": 900,
        "note": "printf shows score and lives.",
        "do": [],
        "out": "30 2\n",
        "outAt": 0.5
      },
      {
        "line": 14,
        "ms": 1800,
        "note": "Postfix: hits++ hands over the old value, 4, to combo. Then hits goes up to 5.",
        "do": [
          {
            "a": "expr",
            "x": {
              "v": "4",
              "t": "int"
            },
            "op": "++",
            "y": null,
            "label": "combo = hits++",
            "len": 0.25
          },
          {
            "a": "calc",
            "v": "4",
            "t": "int",
            "at": 0.3,
            "len": 0.3
          },
          {
            "a": "vars",
            "t": "combo = 4   hits = 5",
            "at": 0.65
          },
          {
            "a": "rule",
            "t": "x++ : old value out, then add 1",
            "at": 0.7
          }
        ]
      },
      {
        "line": 15,
        "ms": 900,
        "note": "combo got the old 4. hits is 5.",
        "do": [],
        "out": "4 5\n",
        "outAt": 0.5
      },
      {
        "line": 16,
        "ms": 1800,
        "note": "Prefix: ++hits adds 1 first, 5 becomes 6, then hands over the new 6.",
        "do": [
          {
            "a": "expr",
            "x": {
              "v": "5",
              "t": "int"
            },
