    "line": 8,
    "ms": 1000,
    "note": "So it prints the message instead of following a missing arrow.",
    "do": [
     {
      "a": "pulse",
      "id": "hp"
     }
    ],
    "out": "No player to heal\n",
    "outAt": 0.3
   },
   {
    "line": 9,
    "ms": 1200,
    "note": "return leaves heal early. The line that would have crashed never runs.",
    "do": [
     {
      "a": "hide",
      "ids": [
       "hp",
       "amt"
      ],
      "fr": [
       "fh"
      ]
     },
     {
      "a": "cap",
      "t": ""
     }
    ]
   },
   {
    "line": 19,
    "ms": 1500,
    "note": "target = &hero writes hero's address into target. Now there is an arrow to follow.",
    "do": [
     {
      "a": "point",
      "id": "target",
      "to": "hero",
      "pv": "0x3000"
     }
    ]
   },
   {
    "line": 20,
    "ms": 1700,
    "note": "heal(target, 10) again. This time p holds a real address.",
    "do": [
     {
      "a": "frame",
      "id": "fh2",
      "t": "heal()",
      "x": 6,
      "y": 158,
      "w": 388,
      "h": 88
     },
     {
      "a": "cell",
      "id": "hp",
      "kind": "ptr",
      "type": "Player*",
      "name": "p",
      "addr": "0x2ff0",
      "x": 40,
      "y": 178,
      "w": 108,
      "h": 58,
      "to": "hero",
      "pv": "0x3000",
      "at": 0.2
     },
     {
      "a": "cell",
      "id": "amt",
      "kind": "int",
      "type": "int",
      "name": "amount",
      "addr": "0x2ff4",
      "v": 10,
      "x": 190,
      "y": 178,
      "w": 108,
      "h": 58,
      "at": 0.2
     }
    ]
   },
   {
    "line": 7,
    "ms": 1100,
    "note": "p == NULL is false, so the function carries on.",
    "do": [
     {
      "a": "cap",
      "t": "if (p == NULL)  ->  false"
     }
    ]
   },
   {
    "line": 11,
    "ms": 2300,
    "note": "Follow the arrow to health: 50 + 10 = 60.",
    "do": [
     {
      "a": "deref",
      "p": "hp",
      "to": "health",
      "v": 60,
      "lbl": "p->health"
     },
     {
      "a": "cap",
      "t": "p->health = 50 + 10;"
     }
    ]
   },
   {
    "line": 12,
    "ms": 1100,
    "note": "heal ends. hero keeps its new health.",
    "do": [
     {
      "a": "hide",
      "ids": [
       "hp",
       "amt"
      ],
      "fr": [
       "fh2"
      ]
     },
     {
      "a": "cap",
      "t": ""
     }
    ]
   },
   {
    "line": 21,
    "ms": 1000,
    "note": "hero is 60.",
    "do": [
     {
      "a": "pulse",
      "id": "health"
     }
    ],
    "out": "hero 60\n",
    "outAt": 0.3
   },
   {
    "line": 23,
    "ms": 1600,
    "note": "fopen could not open the file, so it returned NULL. f is a pointer with nothing to point at.",
    "do": [
     {
      "a": "cell",
      "id": "f",
      "kind": "ptr",
      "type": "FILE*",
      "name": "f",
      "addr": "0x2ffc",
      "x": 278,
      "y": 76,
      "w": 108,
      "h": 62,
      "nul": true
     },
     {
      "a": "cap",
      "t": "fopen(\"no_such_file.txt\") found nothing"
     }
    ]
   },
   {
    "line": 24,
    "ms": 1200,
    "note": "The same check as before: f == NULL is true.",
    "do": [
     {
      "a": "cap",
      "t": "if (f == NULL)  ->  true"
     },
     {
      "a": "pulse",
      "id": "f"
     }
    ]
   },
   {
    "line": 25,
    "ms": 1000,
    "note": "So the program reports the missing file instead of using a pointer to nowhere.",
    "do": [
     {
      "a": "pulse",
      "id": "f"
     }
    ],
    "out": "No file\n",
    "outAt": 0.3
   },
   {
    "line": 27,
    "ms": 700,
    "note": "The program ends.",
    "do": [
     {
      "a": "cap",
      "t": ""
     }
    ]
   }
  ]
 },
 "enum": {
  "scene": "p3b-dial",
  "steps": [
   {
    "line": 3,
    "ms": 1800,
    "note": "enum makes a list of names, and the compiler numbers them for you: 0, 1, 2.",
    "do": [
     {
      "a": "names",
      "n": 3
     }
    ]
   },
   {
    "line": 6,
    "ms": 1300,
    "note": "state is set to STATE_PLAYING. The dial clicks to position 1.",
    "do": [
     {
      "a": "needle",
      "to": 1
     }
    ]
   },
   {
    "line": 7,
    "ms": 900,
    "note": "lives is 0.",
    "do": [
     {
      "a": "lives",
      "v": 0
     }
    ]
   },
   {
    "line": 9,
    "ms": 1400,
    "note": "Each name is really just an int. printf shows the numbers behind the names.",
    "do": [
     {
      "a": "ints"
     }
    ],
    "out": "MENU=0 PLAYING=1 GAMEOVER=2\n",
    "outAt": 0.3
   },
   {
    "line": 10,
    "ms": 1100,
    "note": "Is lives == 0? Yes, so the block runs.",
    "do": [
     {
      "a": "chk",
      "t": "lives == 0",
      "r": true
     }
    ]
   },
   {
    "line": 11,
    "ms": 1300,
    "note": "Assign by name. The dial clicks to position 2, GAMEOVER.",
    "do": [
     {
      "a": "needle",
      "to": 2
     }
    ]
   },
   {
    "line": 13,
    "ms": 1600,
    "note": "switch looks at state and jumps straight to the matching case.",
    "do": [
     {
      "a": "hl",
      "row": 2,
      "sweep": true
     }
    ]
   },
   {
    "line": 16,
    "ms": 1200,
    "note": "The GAMEOVER case runs and prints.",
    "do": [
     {
      "a": "pulse",
      "row": 2
     }
    ],
    "out": "show game over\n",
    "outAt": 0.3
   },
   {
    "line": 18,
    "ms": 700,
    "note": "The program ends.",
    "do": []
   }
  ]
 },
 "headers": {
  "scene": "p3b-files",
  "steps": [
   {
    "line": 1,
    "ms": 1200,
    "note": "player.h is a header. It tells other files what exists, without doing any work.",
    "do": [
     {
      "a": "show",
      "sheet": "h"
     }
    ]
   },
   {
    "line": 2,
    "ms": 1300,
    "note": "#pragma once: read this file only once per .c file, so Player is never defined twice.",
    "do": [
     {
      "a": "hl",
      "sheet": "h",
      "rows": [
       0
      ]
     }
    ]
   },
   {
    "line": 4,
    "ms": 1300,
    "note": "The struct lives in the header, so every file that includes it knows what a Player is.",
    "do": [
     {
      "a": "hl",
      "sheet": "h",
      "rows": [
       1,
       2,
       3
      ]
     }
    ]
   },
   {
    "line": 8,
    "ms": 1300,
    "note": "A prototype: the name and types of player_heal, with no body.",
    "do": [
     {
      "a": "hl",
      "sheet": "h",
      "rows": [
       4,
       5
      ]
     }
    ]
   },
   {
    "line": 10,
    "ms": 1100,
    "note": "player.c is the kitchen, where the work happens.",
    "do": [
     {
      "a": "hl",
      "sheet": null
     },
     {
      "a": "show",
      "sheet": "c"
     }
    ]
   },
   {
    "line": 11,
    "ms": 2200,
    "note": "#include \"player.h\" is a copy and paste. The compiler pastes the header's text right here.",
    "do": [
     {
      "a": "hl",
      "sheet": "c",
      "kind": "inc"
     },
     {
      "a": "paste",
      "sheet": "c",
      "at": 0.25,
      "len": 0.75
     }
    ]
   },
   {
    "line": 13,
    "ms": 1300,
    "note": "The body of player_heal lives here. Only this file needs it.",
    "do": [
     {
      "a": "hl",
      "sheet": "c",
      "kind": "post",
      "rows": [
       0,
       1,
       2
      ]
     }
    ]
   },
   {
    "line": 17,
    "ms": 1200,
    "note": "main.c is a customer. It reads the menu (the header) and never sees the kitchen.",
    "do": [
     {
      "a": "hl",
      "sheet": null
     },
     {
      "a": "show",
      "sheet": "m"
     }
    ]
   },
   {
    "line": 18,
    "ms": 1200,
    "note": "Angle brackets mean the compiler's own library: stdio.h.",
    "do": [
     {
      "a": "hl",
      "sheet": "m",
      "kind": "pre"
     }
    ]
   },
   {
    "line": 19,
    "ms": 2200,
    "note": "Quotes mean a header of mine, in this folder. Same paste, into main.c.",
    "do": [
     {
      "a": "hl",
      "sheet": "m",
      "kind": "inc"
     },
     {
      "a": "paste",
      "sheet": "m",
      "at": 0.25,
      "len": 0.75
     }
    ]
   },
   {
    "line": 24,
    "ms": 1800,
    "note": "main calls player_heal. It knows the name from the header, but the body gets connected later.",
    "do": [
     {
      "a": "hl",
      "sheet": "m",
      "kind": "post",
      "rows": [
       1
      ]
     },
     {
      "a": "call"
     }
    ]
   },
   {
    "line": 27,
    "ms": 1500,
    "note": "That is all three files. Build every .c file together so nothing is left out.",
    "do": [
     {
      "a": "hl",
      "sheet": null
     },
     {
      "a": "build"
     }
    ]
   }
  ]
 },
 "linker": {
  "scene": "p3b-link",
  "steps": [
   {
    "line": 1,
    "ms": 1400,
    "note": "Only main.c is on the command line. player.c is not part of this build.",
    "do": [
     {
      "a": "cmd",
      "t": "cl main.c /Fe:game.exe",
      "main": true,
      "player": false
     }
    ]
   },
   {
    "line": 2,
    "ms": 1700,
    "note": "main.c compiles fine into main.obj. The prototype was enough for the compiler. main.obj has a socket: it needs _player_heal.",
    "do": [
     {
      "a": "compile",
      "f": "main"
     }
    ]
   },
   {
    "line": 3,
    "ms": 2200,
    "note": "The linker hunts for a piece named _player_heal to plug in. There is none. LNK2019.",
    "do": [
     {
      "a": "scan",
      "len": 0.6
     },
     {
      "a": "err",
      "n": 1,
      "at": 0.6,
      "len": 0.4
     }
    ]
   },
   {
    "line": 4,
    "ms": 1300,
    "note": "LNK1120 sums it up: one unresolved name, so no game.exe.",
    "do": [
     {
      "a": "err",
      "n": 2
     }
    ]
   },
   {
    "line": 6,
    "ms": 1600,
    "note": "The fix: list every .c file. Now player.c is in the build too.",
    "do": [
     {
      "a": "clear",
      "len": 0.45
     },
     {
      "a": "cmd",
      "t": "cl main.c player.c /Fe:game.exe",
      "main": true,
      "player": true,
      "at": 0.4
     }
    ]
   },
   {
    "line": 7,
    "ms": 1300,
    "note": "main.c compiles again to main.obj, with its socket.",
    "do": [
     {
      "a": "compile",
      "f": "main"
     }
    ]
   },
   {
    "line": 8,
    "ms": 1500,
    "note": "player.c compiles to player.obj, which offers _player_heal.",
    "do": [
     {
      "a": "compile",
      "f": "player"
     }
    ]
   },
   {
    "line": 9,
    "ms": 2000,
    "note": "The linker matches the name, plugs player.obj into the socket, and builds game.exe.",
    "do": [
     {
      "a": "link"
     }
    ]
   }
  ]
 },
