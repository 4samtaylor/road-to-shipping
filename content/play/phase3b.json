        "note": "main calls reset(&hero.score). &hero.score is the address of just that one box: 0x3004.",
        "do": [
          {
            "a": "tag",
            "id": "score",
            "t": "&hero.score = 0x3004",
            "below": true
          }
        ]
      },
      {
        "line": 8,
        "ms": 1700,
        "note": "reset gets a copy of the address, not a copy of score. Its box holds 0x3004 and an arrow reaches back into main's score.",
        "do": [
          {
            "a": "frame",
            "id": "fr",
            "t": "reset()",
            "x": 6,
            "y": 146,
            "w": 388,
            "h": 98
          },
          {
            "a": "cell",
            "id": "rs",
            "kind": "ptr",
            "type": "int*",
            "name": "score",
            "addr": "0x2ff0",
            "x": 210,
            "y": 172,
            "w": 108,
            "h": 62,
            "to": "score",
            "pv": "0x3004",
            "at": 0.25
          }
        ]
      },
      {
        "line": 9,
        "ms": 2300,
        "note": "*score = 0 follows the arrow and writes 0 into main's box. This is the reset() that copies could never do.",
        "do": [
          {
            "a": "deref",
            "p": "rs",
            "v": 0,
            "lbl": "*score"
          },
          {
            "a": "cap",
            "t": "*score = 0;  follow the arrow, write 0"
          }
        ]
      },
      {
        "line": 10,
        "ms": 1100,
        "note": "reset ends and its pointer vanishes. But the change in main's score box stays.",
        "do": [
          {
            "a": "hide",
            "ids": [
              "rs"
            ],
            "fr": [
              "fr"
            ]
          },
          {
            "a": "cap",
            "t": ""
          }
        ]
      },
      {
        "line": 21,
        "ms": 1400,
        "note": "Next call: &hero is the address of the whole Player, 0x3000.",
        "do": [
          {
            "a": "tag",
            "id": "hero",
            "t": "&hero = 0x3000",
            "below": true
          }
        ]
      },
      {
        "line": 12,
        "ms": 1800,
        "note": "heal gets a Player* named p. Its arrow points at the whole hero group. amount is a plain copy of 25.",
        "do": [
          {
            "a": "frame",
            "id": "fr2",
            "t": "heal()",
            "x": 6,
            "y": 146,
            "w": 388,
            "h": 98
          },
          {
            "a": "cell",
            "id": "hp",
            "kind": "ptr",
            "type": "Player*",
            "name": "p",
            "addr": "0x2ff0",
            "x": 60,
            "y": 172,
            "w": 108,
            "h": 62,
            "to": "hero",
            "pv": "0x3000",
            "at": 0.2
          },
          {
            "a": "cell",
            "id": "amt",
            "kind": "int",
            "type": "int",
            "name": "amount",
            "addr": "0x2ff8",
            "v": 25,
            "x": 210,
            "y": 172,
            "w": 108,
            "h": 62,
            "at": 0.2
          }
        ]
      },
      {
        "line": 13,
        "ms": 2500,
        "note": "p->health means: follow the arrow, then take the health box. 60 + 25 = 85, written into the real hero.",
        "do": [
          {
            "a": "deref",
            "p": "hp",
            "to": "health",
            "v": 85,
            "lbl": "p->health"
          },
          {
            "a": "cap",
            "t": "p->health = 60 + 25;"
          }
        ]
      },
      {
        "line": 14,
        "ms": 1100,
        "note": "heal ends. hero keeps the new health.",
        "do": [
          {
            "a": "hide",
            "ids": [
              "hp",
              "amt"
            ],
            "fr": [
              "fr2"
            ]
          },
          {
            "a": "cap",
            "t": ""
          }
        ]
      },
      {
        "line": 22,
        "ms": 1500,
        "note": "Both changes stuck: health 85 and score 0.",
        "do": [
          {
            "a": "pulse",
            "id": "health",
            "at": 0,
            "len": 0.45
          },
          {
            "a": "pulse",
            "id": "score",
            "at": 0.45,
            "len": 0.45
          }
        ],
        "out": "health 85, score 0\n",
        "outAt": 0.3
      },
      {
        "line": 23,
        "ms": 700,
        "note": "The program ends.",
        "do": []
      }
    ]
  },
