        "do": [
          {
            "a": "read",
            "i": 0,
            "len": 0.5
          },
          {
            "a": "tag",
            "k": "total",
            "v": "3",
            "at": 0.4,
            "len": 0.5
          }
        ]
      },
      {
        "line": 7,
        "ms": 1300,
        "note": "p++ moved one int along. *p is 5, so total is 8.",
        "do": [
          {
            "a": "cur",
            "i": 1,
            "name": "p",
            "len": 0.35
          },
          {
            "a": "read",
            "i": 1,
            "at": 0.35,
            "len": 0.35
          },
          {
            "a": "tag",
            "k": "total",
            "v": "8",
