 "struct-copy": {
  "scene": "p3b-struct",
  "steps": [
   {
    "line": 13,
    "ms": 1200,
    "note": "main builds one Player called hero. Its health box starts as garbage.",
    "do": [
     {
      "a": "frame",
      "id": "fm",
      "t": "main()",
      "x": 4,
      "y": 26,
      "w": 268,
      "h": 112
     },
     {
      "a": "card",
      "id": "hero",
      "title": "hero",
      "sub": "Player",
      "fields": [
       [
        "int",
        "health",
        null
       ]
      ],
      "x": 12,
      "y": 48,
      "w": 116,
      "col": "accent",
      "at": 0.25
     }
    ]
   },
   {
    "line": 14,
    "ms": 1000,
    "note": "hero's health becomes 100.",
    "do": [
     {
      "a": "set",
      "id": "hero",
      "f": 0,
      "v": 100,
      "exp": "hero.health = 100"
     }
    ]
   },
   {
    "line": 15,
    "ms": 1800,
    "note": "Player backup = hero; is a photocopier. Every field of hero is copied into a brand new form.",
    "do": [
     {
      "a": "card",
      "id": "backup",
      "title": "backup",
      "sub": "Player",
      "copy": "hero",
      "fields": [
       [
        "int",
        "health",
        null
       ]
      ],
      "x": 146,
      "y": 48,
      "w": 116,
      "col": "purple"
     }
    ]
   },
   {
    "line": 16,
    "ms": 1000,
    "note": "main calls hurt(hero). C will hand hurt a photocopy, not hero itself.",
    "do": [
     {
      "a": "pulse",
      "id": "hero"
     }
    ]
   },
   {
    "line": 7,
    "ms": 1800,
    "note": "hurt receives its own copy, called p. It lives in hurt's space, separate from main's.",
    "do": [
     {
      "a": "frame",
      "id": "fh",
      "t": "hurt()",
      "x": 280,
      "y": 26,
      "w": 116,
      "h": 112
     },
     {
      "a": "card",
      "id": "p",
      "title": "p",
      "sub": "copy",
      "copy": "hero",
      "fields": [
       [
        "int",
        "health",
        null
       ]
      ],
      "x": 284,
      "y": 48,
      "w": 108,
      "col": "orange",
      "at": 0.1
     }
    ]
   },
   {
    "line": 8,
    "ms": 1200,
    "note": "The copy's health drops by 10. Only the copy changes.",
    "do": [
     {
      "a": "set",
      "id": "p",
      "f": 0,
      "v": 90,
      "exp": "p.health = p.health - 10"
     }
    ]
   },
   {
    "line": 9,
    "ms": 1000,
    "note": "hurt prints 90. It did its job, on a photocopy.",
    "do": [
     {
      "a": "pulse",
      "id": "p"
     }
    ],
    "out": "Inside hurt: 90\n",
    "outAt": 0.3
   },
   {
    "line": 10,
    "ms": 1100,
    "note": "hurt ends and its copy is thrown away.",
    "do": [
     {
      "a": "drop",
      "id": "p"
     },
     {
      "a": "frame",
      "id": "fh",
      "off": true
     }
    ]
   },
   {
    "line": 17,
    "ms": 1100,
    "note": "Back in main, only backup changes: its health becomes 1.",
    "do": [
     {
      "a": "set",
      "id": "backup",
      "f": 0,
      "v": 1,
      "exp": "backup.health = 1"
     }
    ]
   },
   {
    "line": 18,
    "ms": 1500,
    "note": "hero is still 100 and backup is 1. Two separate forms that started out identical.",
    "do": [
     {
      "a": "pulse",
      "id": "hero",
      "f": 0,
      "at": 0,
      "len": 0.45
     },
     {
      "a": "pulse",
      "id": "backup",
      "f": 0,
      "at": 0.45,
      "len": 0.45
     }
    ],
    "out": "hero 100, backup 1\n",
    "outAt": 0.3
   },
   {
    "line": 19,
    "ms": 700,
    "note": "The program ends.",
    "do": []
   }
  ]
 },
 "pointers": {
  "scene": "p3b-mem",
  "steps": [
   {
    "line": 3,
    "ms": 1200,
    "note": "Memory is a row of boxes, and every box has an address, like a house number.",
    "do": [
     {
      "a": "cap",
      "t": "main starts: boxes get built as the lines run"
     }
    ]
   },
   {
    "line": 4,
    "ms": 1200,
    "note": "An ordinary int box named score holds 10. Its address is 0x1000.",
    "do": [
     {
      "a": "cell",
      "id": "score",
      "kind": "int",
      "type": "int",
      "name": "score",
      "addr": "0x1000",
      "v": 10,
      "x": 20,
      "y": 108
     }
    ]
   },
   {
    "line": 5,
    "ms": 1900,
    "note": "&score is score's address. p is a box that holds that address, so an arrow points from p to score.",
    "do": [
     {
      "a": "cell",
      "id": "p",
      "kind": "ptr",
      "type": "int*",
      "name": "p",
      "addr": "0x1004",
      "x": 146,
      "y": 108,
      "to": "score",
      "pv": "0x1000"
     },
     {
      "a": "tag",
      "id": "score",
      "t": "&score = 0x1000",
      "below": true,
      "at": 0.35,
      "len": 0.6
     },
     {
      "a": "cap",
      "t": "int* p = &score;"
     }
    ]
   },
   {
    "line": 6,
    "ms": 1600,
    "note": "copy gets the value 10. It is a separate box with its own address, so it is unrelated to score from now on.",
    "do": [
     {
      "a": "cell",
      "id": "copy",
      "kind": "int",
      "type": "int",
      "name": "copy",
      "addr": "0x1008",
      "v": "",
      "x": 272,
      "y": 108
     },
     {
      "a": "set",
      "id": "copy",
      "v": 10,
      "from": "score",
      "at": 0.3,
      "len": 0.7
     }
    ]
   },
   {
    "line": 8,
    "ms": 2400,
    "note": "*p means: follow the arrow and use the box at the end. Writing 50 there changes score, though score is never named.",
    "do": [
     {
      "a": "deref",
      "p": "p",
      "v": 50,
      "lbl": "*p"
     },
     {
      "a": "cap",
      "t": "*p = 50;  follow the arrow, write 50"
     }
    ]
   },
   {
    "line": 9,
    "ms": 1500,
    "note": "score is 50 and copy is still 10.",
    "do": [
     {
      "a": "pulse",
      "id": "score",
      "at": 0,
      "len": 0.45
     },
     {
      "a": "pulse",
      "id": "copy",
      "at": 0.45,
      "len": 0.45
     },
     {
      "a": "cap",
      "t": ""
     }
    ],
    "out": "score 50, copy 10\n",
    "outAt": 0.25
   },
   {
    "line": 10,
    "ms": 1800,
    "note": "*p reads the same box, so it prints 50. Two names for one box: score and *p.",
    "do": [
     {
      "a": "deref",
      "p": "p",
      "lbl": "*p"
     },
     {
      "a": "cap",
      "t": "*p reads the box p points at"
     }
    ],
    "out": "*p is 50\n",
    "outAt": 0.55
   },
   {
    "line": 11,
    "ms": 700,
    "note": "The program ends.",
    "do": [
     {
      "a": "cap",
      "t": ""
     }
    ]
   }
  ]
 },
