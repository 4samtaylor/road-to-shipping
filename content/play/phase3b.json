        "note": "p holds the address of hits[1]. Picture it as a finger pointing at locker 1.",
        "do": [
          {
            "a": "cur",
            "i": 1,
            "name": "p"
          },
          {
            "a": "cap",
            "t": "int* p = &hits[1];"
          }
        ]
      },
      {
        "line": 15,
        "ms": 2600,
        "note": "*p reads 5. p + 2 is two lockers along, not two bytes: hits[3], which holds 7.",
        "do": [
          {
            "a": "read",
            "i": 1,
            "at": 0,
            "len": 0.3
          },
          {
            "a": "cur",
