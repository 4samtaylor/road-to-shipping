          }
        ]
      },
      {
        "line": 7,
        "ms": 1300,
        "note": "p++ again. *p is 2, so total is 10.",
        "do": [
          {
            "a": "cur",
            "i": 2,
            "name": "p",
            "len": 0.35
          },
          {
            "a": "read",
            "i": 2,
            "at": 0.35,
            "len": 0.35
          },
          {
            "a": "tag",
            "k": "total",
            "v": "10",
            "at": 0.55,
            "len": 0.4
          }
        ]
      },
