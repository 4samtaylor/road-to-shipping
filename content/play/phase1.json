            "a": "files",
            "p": 0,
            "list": [
              [
                "hello_world.c",
                "S"
              ],
              [
                "build.bat",
                "S"
              ]
            ]
          }
        ]
      },
      {
        "line": 3,
        "ms": 1800,
        "note": "git commit seals the envelope with a label. The new dot appears on your PC only.",
