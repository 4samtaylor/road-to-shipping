  "variables": {
    "scene": "boxes",
    "steps": [
      {
        "line": 4,
        "ms": 1100,
        "note": "int score; builds a box for a whole number. Nothing has been put in it yet.",
        "do": [
          {
            "a": "cap",
            "t": "score: not set yet",
            "at": 0.3,
            "len": 0.4
          }
        ]
      },
      {
        "line": 5,
        "ms": 1300,
        "note": "lives is made and filled in one go: it starts at 3.",
        "do": [
          {
            "a": "appear",
            "slot": 4,
            "len": 0.3
          },
          {
            "a": "drop",
            "slot": 4,
            "shape": "sq",
            "text": "3",
            "val": "3",
            "at": 0.3
          }
        ]
      },
      {
        "line": 6,
        "ms": 1000,
        "note": "level gets a box too, holding 1. There's only room to draw two.",
        "do": [
          {
            "a": "cap",
            "t": "level = 1",
            "at": 0.2,
            "len": 0.4
          }
        ]
      },
      {
        "line": 8,
        "ms": 1100,
        "note": "= stores the 0 in score. Now it holds something you can trust.",
        "do": [
          {
            "a": "drop",
            "slot": 0,
            "shape": "sq",
            "text": "0",
            "val": "0"
          }
        ]
      },
      {
        "line": 9,
        "ms": 1100,
        "out": "Score: 0\n",
        "outAt": 0.5,
        "note": "%d is filled with what score holds right now.",
        "do": [
          {
            "a": "pick",
            "slots": [
              0
            ]
          }
        ]
      },
      {
        "line": 11,
