        "do": [
          {
            "a": "files",
            "p": 0,
            "list": [
              [
                "hello_world.c",
                "S"
              ],
              [
                "build.bat",
                "??"
              ]
            ]
          }
        ]
      },
      {
        "line": 2,
        "ms": 1100,
        "note": "Then build.bat. Both are in the envelope. Nothing is saved yet.",
