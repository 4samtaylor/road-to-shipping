              1,
              1
            ],
            "names": [
              "Your PC",
              "GitHub",
              "Person A's PC"
            ],
            "at": 0,
            "len": 0.1
          },
          {
            "a": "world",
            "p": 0,
            "cs": [
              [
                "c1",
                0,
                0,
                [],
                {
                  "hash": "3a9f0d1"
                }
              ]
            ],
            "br": [
