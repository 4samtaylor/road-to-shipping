              ],
              [
                "origin/main",
                "c1",
                1
              ]
            ],
            "head": "main",
            "files": [],
            "at": 0,
            "len": 0.3
          },
          {
            "a": "world",
            "p": 1,
            "cs": [
              [
                "c1",
                0,
                0,
                [],
                {
                  "hash": "3a9f0d1"
                }
              ]
            ],
            "br": [
              [
                "main",
                "c1"
              ]
            ],
            "head": "main",
            "files": [],
            "at": 0.05,
            "len": 0.3
          }
        ]
      },
      {
        "line": 1,
        "ms": 1500,
        "note": "Two new files, not yet in any snapshot. Git lists them as untracked.",
        "out": "Untracked files:\n  (use \"git add <file>...\" to include in what will be committed)\n\tbuild.bat\n\thello_world.c\n\nnothing added to commit but untracked files present (use \"git add\" to track)\n",
        "outAt": 0.2,
