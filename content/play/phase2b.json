          }
        ]
      },
      {
        "line": 7,
        "ms": 800,
        "note": "printf asks the question.",
        "do": [],
        "out": "Guess: ",
        "outAt": 0.3
      },
      {
        "line": 8,
        "ms": 1100,
        "note": "scanf reads the player's number into guess. (Sample run: the player types 30.)",
        "do": [
          {
            "n": "guess",
            "val": 30,
            "a": "set"
          }
        ],
        "out": "30\n",
        "outAt": 0.3
      },
      {
        "line": 10,
        "ms": 1500,
        "note": "The runner reaches the first door. Its sign says guess == secret, which is 30 == 42.",
