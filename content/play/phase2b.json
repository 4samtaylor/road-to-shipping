            "a": "knock"
          }
        ]
      },
      {
        "line": 12,
        "ms": 1500,
        "note": "False, so this door stays shut. Next door: guess < secret, which is 30 < 42.",
        "do": [
          {
            "to": 200,
            "len": 0.55,
            "a": "walk"
          },
          {
            "door": 1,
            "v": "30 < 42",
            "r": true,
            "at": 0.55,
            "len": 0.45,
            "a": "knock"
          }
        ]
      },
      {
        "line": 13,
        "ms": 1400,
